# This portal's public URL. Also the `iss` of its launch tokens, and the
# origin the advisor will allow to frame it.
PORTAL_URL=http://127.0.0.1:5100

# The advisor's launch endpoint (API host) and the origin its app runs on.
ADVISOR_LAUNCH_URL=http://localhost:5000/lti/launch
ADVISOR_APP_ORIGIN=http://localhost:5173

# Issued by the advisor when this portal was registered.
ADVISOR_CLIENT_ID=scu-portal
ADVISOR_DEPLOYMENT_ID=scu-1

SECRET_KEY=change-me
# RSA private key (PEM, \n-escaped) for signing launches. Leave blank locally:
# one is generated into keys/ on first start.
PORTAL_PRIVATE_KEY=
PORT=5100
