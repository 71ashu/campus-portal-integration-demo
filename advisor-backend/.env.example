FLASK_ENV=development
SECRET_KEY=dev-secret-key
# Leave unset to use sqlite:///<repo path>/advisor-backend/advisor.db. Only
# set this if you want a different file or a real database (e.g. Postgres).
# DATABASE_URL=sqlite:////absolute/path/to/advisor.db
FRONTEND_URL=http://localhost:5173

# Mock SIS integration
SIS_BASE_URL=http://localhost:5050
SIS_PROGRAM_ID=BS-CS-2024
# Leave blank for local demo; set to a shared value on both this and
# mock-sis/.env to require the header on the grade-posted webhook.
SIS_WEBHOOK_TOKEN=

# Optional — enables GPT-4o-mini advisory messages; falls back to templates without it.
OPENAI_API_KEY=
