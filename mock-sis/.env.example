# Where to POST when a grade is posted: the advisor's webhook for this campus.
ADVISOR_WEBHOOK_URL=http://localhost:5000/api/webhooks/sis/scu/grade-posted

# HMAC secret for signing webhooks. Must equal the advisor's SCU_SIS_WEBHOOK_SECRET.
SIS_WEBHOOK_SECRET=

# API keys allowed to read /sis/* (comma-separated). Must include the advisor's SCU_SIS_API_KEY.
SIS_API_KEYS=

PORT=5050
